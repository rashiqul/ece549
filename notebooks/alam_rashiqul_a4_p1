        "def get_horizon_line(vp1, vp2):",
        "    \"\"\"",
        "    Calculates the ground horizon line from two vanishing points.",
        "    ",
        "    Inputs:",
        "        vp1: np.ndarray of shape (3,) - first vanishing point (homogeneous)",
        "        vp2: np.ndarray of shape (3,) - second vanishing point (homogeneous)",
        "    ",
        "    Returns:",
        "        horizon_line: np.ndarray of shape (3,) representing line parameters",
        "                      (a, b, c) where ax + by + c = 0, normalized so a^2 + b^2 = 1",
        "    \"\"\"",
        "    # The horizon line passes through two vanishing points",
        "    # Use cross product to find the line",
        "    horizon_line = np.cross(vp1, vp2)",
        "    ",
        "    # Normalize so that a^2 + b^2 = 1",
        "    norm = np.sqrt(horizon_line[0]**2 + horizon_line[1]**2)",
        "    if norm > 1e-8:",
        "        horizon_line = horizon_line / norm",
        "    ",
        "    return horizon_line"
      ]
    },
